  "bindings": [
    {
      "claimId": "interp-tu-phu-dong-cung-giap-menh",
      "binding": {
        "ok": true,
        "reason": null,
        "approvedWording": "Tuổi Giáp có cách này chắc chắn là được hưởng phúc trọn đời và dĩ nhiên là được hưởng phú qúy song toàn. Đây là lời sách truyền thống, không phải sự kiện đời đã kiểm chứng."
      }
    },
    {
      "claimId": "interp-quanshu-tai-bach-tu-vi-four-adverse-host",
      "binding": {
        "ok": true,
        "reason": null,
        "kind": "source_palace_interpretation",
        "target": "tai_bach",
        "sourceProfile": "quanshu-iztro-2f00e2ab",
        "approvedWording": "Riêng mục Tử Vi tại Tài Bạch của bản chép này dùng mệnh đề “不旺” khi thêm nhóm sát tinh được nêu. Phạm vi đang xét là Kình Dương, Đà La, Hỏa Tinh hoặc Linh Tinh đồng cung; không dùng riêng câu mở đầu về sự sung túc làm lời kết cho cung này. Đây là lời sách truyền thống, không phải sự kiện đời đã kiểm chứng."
      }
    },
    {
      "claimId": "interp-quanshu-phuc-duc-dong-luong-host",
      "binding": {
        "ok": true,
        "reason": null,
        "kind": "source_palace_interpretation",
        "target": "phuc_duc",
        "sourceProfile": "quanshu-iztro-2f00e2ab",
        "approvedWording": "Riêng mục Thiên Đồng tại Phúc Đức của bản chép này, Thiên Lương đồng cung được mô tả bằng nhánh “清閑快樂”, nghĩa là thanh nhàn, vui vẻ. Câu này chỉ phản ánh nhánh đồng cung đang xét, không tổng kết toàn bộ lá số và không suy ra tuổi thọ. Đây là lời sách truyền thống, không phải sự kiện đời đã kiểm chứng."
      }
    },
    {
      "claimId": "interp-quanshu-quan-loc-co-cu-dau-host",
      "binding": {
        "ok": true,
        "reason": null,
        "kind": "source_palace_interpretation",
        "target": "quan_loc",
        "sourceProfile": "quanshu-iztro-2f00e2ab",
        "approvedWording": "Trong mục Quan Lộc của bản chép này, trường hợp Cự Môn đồng cung Thiên Cơ tại Dậu được ghi ‘雖美無始終’. Đây là ghi chú về đúng nhánh văn bản, không phải kết luận toàn bộ công danh hay sự kiện đời đã kiểm chứng; các điều kiện gia sát trong đoạn chưa được đánh giá."
      }
    },
    {
      "claimId": "interp-quanshu-phuc-co-cu-host",
      "binding": {
        "ok": true,
        "reason": null,
        "kind": "source_palace_interpretation",
        "target": "phuc_duc",
        "sourceProfile": "quanshu-iztro-2f00e2ab",
        "approvedWording": "Riêng hai mục Thiên Cơ và Cự Môn tại Phúc Đức của bản chép này, nhánh hai sao đồng cung được ghi “勞力欠安” và “心忙不安”, gợi hình ảnh lao lực, lòng bận bịu, chưa yên. Đây là lời mô tả truyền thống cho đúng nhánh văn bản, không xác nhận tính cách hay tình trạng sức khỏe; các điều kiện gia sát ở cuối đoạn chưa được đánh giá."
      }
    },
    {
      "claimId": "interp-quanshu-tai-tuvi-pha-quan-host",
      "binding": {
        "ok": true,
        "reason": null,
        "kind": "source_palace_interpretation",
        "target": "tai_bach",
        "sourceProfile": "quanshu-iztro-2f00e2ab",
        "approvedWording": "Riêng mục Tử Vi tại Tài Bạch của bản chép này, nhánh Phá Quân đồng cung được ghi “先難後易”, nghĩa là trước khó, sau dễ. Đây là lời mô tả truyền thống cho đúng nhánh văn bản, không xác nhận tài sản hay kết quả cuộc đời; các điều kiện gia sát ở các đoạn liên quan chưa được đánh giá."
      }
    },
    {
      "claimId": "interp-quanshu-quan-co-cu-mao-host",
      "binding": {
        "ok": true,
        "reason": null,
        "kind": "source_palace_interpretation",
        "target": "quan_loc",
        "sourceProfile": "quanshu-iztro-2f00e2ab",
        "approvedWording": "Trong mục Quan Lộc của bản chép này, trường hợp Cự Môn đồng cung Thiên Cơ tại Mão được ghi “吉美”. Đây là ghi chú về đúng nhánh văn bản, không phải xếp hạng, kết luận toàn bộ công danh hay sự kiện đời đã kiểm chứng; các điều kiện gia sát trong đoạn chưa được đánh giá."
      }
    }
  ],
