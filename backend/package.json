    "cors": "^2.8.6",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "tuvi-project-root": "file:.."
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "nodemon": "^3.1.14"
  }
}
